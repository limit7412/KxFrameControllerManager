# KxFrameControllerManager の systemd ユーザーユニット（仕様書 6.2 節）。
# `kx-frame-controller-manager install` が @EXECUTABLE@ を実行ファイルの絶対パスに置き換えて
# ~/.config/systemd/user/ へ書き出す。

[Unit]
Description=KxFrameControllerManager (turn off Steam Frame controllers with a long press)
# 異常終了が続いたときに SteamVR へ負荷を掛け続けないよう、5 分に 5 回で止める。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart="@EXECUTABLE@" run
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
